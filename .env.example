# Server-side only. Keep values in .env.local and hosting environment settings.
# NLT: https://api.nlt.to/Account/Register (TEST opts into limited anonymous access)
NLT_API_KEY=
# Public, build-time origin for About link and metadata. No path, query or secrets.
# Local development can omit it to use http://localhost:3000.
# Set the intended HTTPS site origin in Vercel before deploying.
NEXT_PUBLIC_SITE_URL=
